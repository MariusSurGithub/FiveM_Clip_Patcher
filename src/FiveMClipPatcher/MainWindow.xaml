<Window x:Class="FiveMClipPatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FiveMClipPatcher.ViewModels"
        Title="FiveM Clip Patcher"
        Height="960"
        Width="1320"
        MinHeight="780"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="FiveM Clip Patcher" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Coche une ou plusieurs séquences, puis scanne ou patche. Backup auto, remplacement in-place."/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"
                               Foreground="{StaticResource AccentHoverBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Ouvrir backups"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenBackupFolderCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar DockPanel.Dock="Top"
                     Height="4"
                     Margin="0,0,0,12"
                     Minimum="0"
                     Maximum="{Binding ProgressMaximum}"
                     Value="{Binding ProgressValue}"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"/>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       Text="Port GUI de FiveM_Clip_Patcher par WaydeTheKiwi — CC BY-NC-SA 4.0. Ferme GTA / FiveM avant de patcher."/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="480"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2.5*" MinHeight="320"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- Path bar -->
            <Border Grid.ColumnSpan="3" Style="{StaticResource PanelHost}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DOSSIER CLIPS" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ClipsPath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Dossier…"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseFolderCommand}"/>
                        <Button Grid.Column="2" Content="Fichier…"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseFileCommand}"/>
                        <Button Grid.Column="3" Content="GTA défaut"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Command="{Binding UseDefaultGtaPathCommand}"/>
                        <Button Grid.Column="4" Content="Actualiser"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Command="{Binding ReloadClipsCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Séquences -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelHost}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SÉQUENCES" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource MutedText}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Tout cocher"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,0,6,0"
                                    Command="{Binding SelectAllCommand}"/>
                            <Button Content="Tout décocher"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding SelectNoneCommand}"/>
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Clips}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ClipItemViewModel}">
                                <Border Background="{StaticResource SurfaceElevatedBrush}"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                        <Border Grid.Column="1"
                                                Width="128" Height="72"
                                                CornerRadius="6"
                                                ClipToBounds="True"
                                                Background="#10141C"
                                                Margin="0,0,12,0"
                                                MouseLeftButtonUp="ClipRow_OnActivate">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="…"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Visibility="{Binding IsThumbnailLoading, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    MouseLeftButtonUp="ClipRow_OnActivate">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12">
                                                <Run Text="{Binding DateText, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding MatchSummary}"
                                                       Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource OkBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"/>

            <!-- Patterns / Options (onglets, pleine hauteur) -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelHost}" Padding="0">
                <TabControl Style="{StaticResource AppTabControl}" Padding="12,8,12,12">
                    <TabItem Header="Patterns" Style="{StaticResource AppTabItem}">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"
                                           Text="Un pattern par ligne. Exact = substring. Wildcard (*) = nom isolé."/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="Détecter"
                                            Style="{StaticResource GhostButton}"
                                            Margin="0,0,6,0"
                                            ToolTip="Analyser tes clips et suggérer des patterns"
                                            Command="{Binding DiscoverPatternsCommand}"/>
                                    <Button Content=".txt"
                                            Style="{StaticResource GhostButton}"
                                            Margin="0,0,6,0"
                                            Command="{Binding LoadPatternsFileCommand}"/>
                                    <Button Content="Reset"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding ResetPatternsCommand}"/>
                                </StackPanel>
                            </Grid>
                            <TextBox Grid.Row="1"
                                     Text="{Binding PatternsText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     FontSize="12"
                                     MinHeight="160"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Options" Style="{StaticResource AppTabItem}">
                        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <CheckBox Content="Sous-dossiers (récursif)" IsChecked="{Binding Recursive}" Margin="0,0,0,0"/>
                                <CheckBox Content="Insensible à la casse" IsChecked="{Binding CaseInsensitive}"/>
                                <CheckBox Content="Remplacer par du texte (sinon null bytes)"
                                          IsChecked="{Binding UsePlaceholderMode}"/>
                                <TextBlock Text="Placeholder" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding Placeholder, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UsePlaceholderMode}"/>
                                <TextBlock Text="Extensions patchées" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Backups" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BackupLocation, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
                                    <Button Grid.Column="1" Content="Parcourir…"
                                            Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0"
                                            Command="{Binding BrowseBackupCommand}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Actions -->
            <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Scanner la sélection"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="14"
                        Padding="18,12"
                        Command="{Binding ScanCommand}"/>
                <Button Grid.Column="2"
                        Content="Patcher la sélection"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="15"
                        Padding="18,12"
                        Command="{Binding PatchCommand}"/>
            </Grid>

            <GridSplitter Grid.Row="3" Grid.ColumnSpan="3"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"/>

            <!-- Log -->
            <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource PanelHost}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="LOG" Style="{StaticResource SectionTitle}"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FontSize="12"
                             MinHeight="72"
                             Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
